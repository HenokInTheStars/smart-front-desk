# backend/.env.example  ->  copy to .env
DATABASE_URL=postgresql+asyncpg://frontdesk:frontdesk@localhost:5432/frontdesk
OPENAI_API_KEY=sk-...              # team key, issued Week 3
JWT_SECRET=change-me-random-64-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGIN=http://localhost:3000

# AfroMessage Integration
AFROMESSAGE_API_KEY=your-afromessage-bearer-token
AFROMESSAGE_SENDER_NAME=your-sender-id

# AI Assistant (OpenAI-compatible, e.g. Gemini, OpenAI, Groq, Ollama)
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
AI_REASONING_EFFORT=minimal

# Dedicated Read-Only Connection for AI Assistant (assistant_ro role)
DATABASE_URL_READONLY=postgresql+asyncpg://assistant_ro:assistant_ro_secret@localhost:5432/frontdesk
ASSISTANT_RO_PASSWORD=assistant_ro_secret

# Dedicated Isolated Test Database
TEST_DATABASE_URL=postgresql+asyncpg://frontdesk:frontdesk@localhost:5432/frontdesk_test

# Auto-seed default dev users and hosts on application startup (DEV ONLY - must be false in production)
SEED_DEFAULT_USERS=false

# Production Bootstrap Super Admin (optional: creates initial root admin if none exists)
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=your-secure-entropy-rich-password-min12chars
